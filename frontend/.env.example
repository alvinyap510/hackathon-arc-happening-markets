# Copy to .env.local and adjust. Never commit real secrets.

# mock  = fully standalone UI with scripted fixtures (default for demos)
# real  = talk to the venue backend (REST + WS)
VITE_API_MODE=mock

# Base URL of the venue backend when VITE_API_MODE=real.
# Leave empty to use the Vite dev proxy (/api -> VITE_BACKEND_ORIGIN).
VITE_API_URL=

# Dev-proxy target (vite.config.ts), real mode only.
VITE_BACKEND_ORIGIN=http://localhost:8080
