# Venue backend environment — copy to .env and fill in. NEVER commit real secrets.
# Every variable here is a placeholder; real values live only in your local .env / env.

# ----------------------------------------------------------------------------
# REQUIRED. A STABLE secret used to derive RFM commit salts (SaltService). The
# reveal endpoint recomputes the SAME salt from this secret, so it MUST NOT change
# between a commit and its reveal — a changed/empty secret on restart makes every
# prior commit unrevealable and slashes the MM's 500 USDC bond. Set once, keep it.
# ----------------------------------------------------------------------------
Venue__SaltSecret=change-me-to-a-long-random-stable-secret

# Chain seam. Simulate=true runs the in-memory SimulatedChainGateway (local demo,
# no RPC). Simulate=false requires the Arc RPC + an operator key + demo user keys.
Venue__Simulate=true
Venue__Chain__RpcUrl=https://rpc.devnet.arc.io
Venue__Chain__ChainId=5042002
Venue__Chain__StartBlock=0
Venue__Chain__Vault=0x0000000000000000000000000000000000000001
Venue__Chain__OutcomeTokens=0x0000000000000000000000000000000000000002
Venue__Chain__Exchange=0x0000000000000000000000000000000000000003
Venue__Chain__Rfm=0x0000000000000000000000000000000000000004
Venue__Chain__Usdc=0x3600000000000000000000000000000000000000
Venue__Chain__OperatorAddress=0x0000000000000000000000000000000000000005

# Demo RFM auction windows (seconds). Short values make a local demo fast.
Venue__RfmWindows__CommitSeconds=120
Venue__RfmWindows__RevealSeconds=60

# Circle Wallets / CCTP (REST). Leave empty to use the in-memory Circle mock.
Venue__Circle__ApiKey=
Venue__Circle__EntitySecretCiphertext=
Venue__Circle__BaseUrl=https://api.circle.com/v1

# Real-chain operator + dev-controlled SCA keys (Simulate=false only). NEVER in git.
Venue__OperatorPrivateKey=
